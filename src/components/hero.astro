---
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="w-full min-h-screen bg-neutral-950 text-white flex flex-col justify-between overflow-x-hidden">
  <!-- Hero-Sektion (Kompakt auf eine Seite optimiert) -->
  <section
    class="relative flex-1 flex items-center justify-center px-4 py-8 lg:py-12 overflow-hidden">
    <!-- Hintergrundbild mit sanftem Overlay -->
    <div class="absolute inset-0 z-0 opacity-40">
      <Picture
        src={heroImage}
        alt="Außenansicht der Fahrradschmiede in Berlin"
        formats={["avif", "webp"]}
        loading="eager"
        class="w-full h-full object-cover"
      />
    </div>
    <div
      class="absolute inset-0 bg-linear-to-t from-neutral-950 via-neutral-950/70 to-transparent z-0">
    </div>

    <!-- Inhalt -->
    <div
      class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center gap-4 lg:gap-6">
      <!-- Badge -->
      <span
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-600/20 text-orange-400 text-xs md:text-sm font-medium border border-orange-500/30">
        <Icon name="tabler:map-pin" class="w-4 h-4" /> Deine Fahrradwerkstatt & Store
        in Berlin
      </span>

      <!-- Haupt-Überschrift (etwas kompakter skaliert) -->
      <h1
        class="text-3xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
        Fahrräder, Service & <span class="text-orange-500">Handwerk</span>
      </h1>

      <!-- Kurzer Text -->
      <p class="text-base md:text-lg text-neutral-300 max-w-xl font-normal">
        Über 300 neue und gebrauchte Fahrräder im Angebot, fairer Ankauf sowie
        blitzschneller Werkstatt-Service direkt vor Ort. Ohne langes Warten,
        erst testen dann kaufen.
      </p>

      <!-- CTA-Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto mt-2">
        <Link
          href="/fahrraeder"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-base transition-all shadow-lg shadow-orange-600/30">
          <Icon name="tabler:bike" class="w-5 h-5" />
          Zu den Fahrrädern
        </Link>

        <!-- <Link
          href="/kontakt"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-white font-semibold text-base border border-neutral-700 transition-all">
          <Icon name="tabler:tools" class="w-5 h-5" />
          Werkstatt-Termin anfragen
        </Link> -->
      </div>
    </div>
  </section>

  <!-- Kompakte USPs direkt als unterster Abschluss -->
  <section
    class="relative z-10 border-t border-neutral-800/80 bg-neutral-950/80 backdrop-blur py-4 px-4">
    <div
      class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
      <div class="flex items-center justify-center gap-3">
        <Icon
          name="tabler:shield-check"
          class="w-6 h-6 text-orange-500 shrink-0"
        />
        <span class="text-sm font-medium text-neutral-300"
          >100% Geprüfte Räder</span
        >
      </div>

      <div class="flex items-center justify-center gap-3">
        <Icon name="tabler:bolt" class="w-6 h-6 text-orange-500 shrink-0" />
        <span class="text-sm font-medium text-neutral-300"
          >Express-Werkstattservice</span
        >
      </div>

      <div class="flex items-center justify-center gap-3">
        <Icon name="tabler:coin" class="w-6 h-6 text-orange-500 shrink-0" />
        <span class="text-sm font-medium text-neutral-300"
          >Faire An- & Verkaufspreise</span
        >
      </div>
    </div>
  </section>
</main>
