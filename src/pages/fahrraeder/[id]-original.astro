---
// src/pages/fahrraeder/[id].astro
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

// Wenn du SSR nutzt, kannst du die ID direkt aus der URL holen:
const { id } = Astro.params;

// API abrufen (gleiche URL wie auf der Übersicht)
const apiUrl =
  import.meta.env.X_API_URL || "http://localhost/api/php/getBikesInfos.php";
const apiKey = import.meta.env.DB_API_KEY || "";

let bike = null;
let error = "";

try {
  const response = await fetch(apiUrl, {
    headers: { "X-API-KEY": apiKey },
  });
  if (!response.ok) throw new Error("Fehler beim Laden der Daten");
  const bikes = await response.json();

  // Wir suchen das passende Fahrrad (entweder über eine ID oder den Index/Titel)
  // Falls deine Datenbank eine ID hat, ersetze index mit bike.id
  bike = bikes.find((b: any, index: number) => String(index) === id);
} catch (e: any) {
  error = e.message;
}
---

<Layout title={bike ? `${bike.Fahrrad} - Details` : "Fahrrad nicht gefunden"}>
  <main class="max-w-4xl mx-auto px-4 py-8">
    {/* Zurück-Knopf (Browser-Verlauf oder fixer Link) */}
    <div class="mb-6">
      <a
        href="/fahrraeder"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium transition-colors text-sm">
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        Zurück zur Übersicht
      </a>
    </div>

    {
      error && (
        <div class="bg-red-50 text-red-700 p-4 rounded-xl border border-red-200">
          <p>{error}</p>
        </div>
      )
    }

    {
      bike ? (
        <div class="bg-white rounded-3xl border border-gray-100 shadow-xl overflow-hidden grid grid-cols-1 md:grid-cols-2 gap-8 p-6 md:p-8">
          {/* Linke Spalte: Großes Bild */}
          <div class="relative rounded-2xl overflow-hidden bg-gray-100 aspect-4/3 flex items-center justify-center">
            <img
              src={bike.Hauptbild_URL || "/placeholder-bike.jpg"}
              alt={bike.Fahrrad}
              class="w-full h-full object-cover"
            />
          </div>

          {/* Rechte Spalte: Vollständige Details */}
          <div class="flex flex-col justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-wider text-orange-600 mb-2">
                {bike.Ort || "Standort: Berlin"}
              </p>

              <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
                {bike.Fahrrad}
              </h1>

              <div class="text-3xl font-extrabold text-emerald-800 mb-6">
                {bike.Preis} €
              </div>

              <hr class="border-gray-100 mb-6" />

              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-2">
                Beschreibung
              </h3>
              <p class="text-gray-600 leading-relaxed whitespace-pre-line mb-6">
                {bike.Beschreibung || "Keine Beschreibung vorhanden."}
              </p>
            </div>

            {/* Kontakt / Aktion Button */}
            <div>
              <a
                href={`mailto:info@bikeparkberlin.de?subject=Anfrage zu ${encodeURIComponent(bike.Fahrrad)}`}
                class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold shadow-lg shadow-orange-600/30 transition-all">
                <Icon name="tabler:mail" class="w-5 h-5" />
                Interesse anfragen
              </a>
            </div>
          </div>
        </div>
      ) : (
        !error && (
          <div class="text-center py-16 bg-gray-50 rounded-3xl border border-dashed border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800 mb-2">
              Fahrrad nicht gefunden
            </h2>
            <p class="text-gray-500 mb-6">
              Das gesuchte Fahrrad existiert nicht oder wurde bereits entfernt.
            </p>
            <a
              href="/fahrraeder"
              class="text-orange-600 font-medium hover:underline">
              Zurück zur Übersicht
            </a>
          </div>
        )
      )
    }
  </main>
</Layout>
