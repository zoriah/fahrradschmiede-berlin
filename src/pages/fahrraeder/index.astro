---
// src/pages/fahrraeder/index.astro
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const apiUrl =
  import.meta.env.X_API_URL || "http://localhost/api/php/getBikesInfos.php";
const apiKey = import.meta.env.X_API_KEY || "";

interface Bike {
  produkt_id: number;
  titel: string;
  beschreibung: string;
  slug: string;
  preis: string;
  zustand?: string | null;
  filiale?: string | null;
  bild_url?: string | null;
}

let bikes: Bike[] = [];
let error = "";

try {
  const response = await fetch(apiUrl, {
    method: "GET",
    headers: {
      "Content-Type": "application/json",
      "X-API-KEY": apiKey,
    },
  });

  if (!response.ok) {
    throw new Error(`Fehler beim Laden: ${response.statusText}`);
  }

  const jsonResponse = await response.json();

  if (jsonResponse && jsonResponse.data && Array.isArray(jsonResponse.data)) {
    bikes = jsonResponse.data;
  } else if (Array.isArray(jsonResponse)) {
    bikes = jsonResponse;
  } else {
    bikes = [];
  }
} catch (e: any) {
  error = e.message || "Fehler beim Laden der Fahrrad-Daten.";
  console.error("API Fetch Error:", e);
}
---

<Layout title="Fahrräder - Bikepark Berlin">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Header-Bereich */}
    <div
      class="mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Neueste Anzeigen
      </h1>

      {/* Schwebender Zurück-Knopf */}
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md text-white text-sm font-medium border border-white/10 shadow-lg transition-all duration-200">
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        Zurück zur Startseite
      </a>
    </div>

    {
      error && (
        <div class="bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-xl mb-6">
          <p class="font-medium">{error}</p>
        </div>
      )
    }

    {/* Exaktes Kleinanzeigen-Grid ohne Kasten-Design */}
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-8">
      {
        bikes.map((bike, index) => (
          <a
            href={`/fahrraeder/${index}`}
            class="group flex flex-col text-left cursor-pointer">
            {/* Bild-Container mit abgerundeten Ecken und Herz-Button oben rechts */}
            <div class="relative w-full aspect-4/3 rounded-2xl overflow-hidden bg-gray-100 mb-2.5 shadow-sm">
              <img
                src={bike.bild_url || "/placeholder-bike.jpg"}
                alt={bike.titel}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />

              {/* Favoriten-Herz-Button */}
              <button
                type="button"
                aria-label="Zu Favoriten hinzufügen"
                class="absolute top-3 right-3 w-8 h-8 bg-white/90 hover:bg-white backdrop-blur-md rounded-full flex items-center justify-center text-gray-700 hover:text-red-500 shadow-md transition-all duration-200"
                onclick="event.preventDefault(); event.stopPropagation(); this.classList.toggle('text-red-500')">
                <Icon name="tabler:heart" class="w-4 h-4" />
              </button>
            </div>

            {/* Standort / Filiale (ganz klein und dezent unten drunter) */}
            <p class="text-xs text-gray-400 font-normal mb-1">
              {bike.filiale || "Berlin Center"}
            </p>

            {/* Titel / Beschreibung */}
            <h2 class="text-sm font-normal text-gray-200 group-hover:text-white line-clamp-2 leading-snug mb-1.5 transition-colors">
              {bike.titel}
            </h2>

            {/* Preis & Zustand in einer Zeile unten */}
            <div class="flex items-center justify-between mt-auto pt-1">
              <span class="text-base sm:text-lg font-bold text-emerald-400">
                {bike.preis ? `${bike.preis} €` : "VB"}
              </span>

              <span class="text-xs text-gray-400 font-medium">
                {bike.zustand || "Gebraucht"}
              </span>
            </div>
          </a>
        ))
      }
    </div>

    {
      bikes.length === 0 && !error && (
        <div class="text-center py-16 bg-gray-800/40 rounded-2xl border border-dashed border-gray-700">
          <Icon
            name="tabler:bike"
            class="w-12 h-12 text-gray-400 mx-auto mb-3"
          />
          <p class="text-gray-300 font-medium">
            Derzeit sind keine Fahrräder verfügbar.
          </p>
        </div>
      )
    }
  </main>
</Layout>
